root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 100

[*.{toml,yml,yaml}]
indent_size = 2

[*.json]
max_line_length = off

[*.md]
ij_any_spaces_within_braces = false
ij_any_spaces_within_brackets = false
indent_size = 2
max_line_length = off
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
